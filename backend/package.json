{
  "name": "clinic-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Psychiatric Practice Management System & Clinical AI Assistant — Backend (RPS-2)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "test": "tsx tests/audit-be701.test.ts && tsx tests/billing-be301.test.ts && tsx tests/debt-advisory.test.ts && tsx tests/endpoints-be-remediation.test.ts && tsx tests/queue-be203.test.ts && tsx tests/queue-completion.test.ts && tsx tests/queue-state.test.ts && tsx tests/realtime-be401.test.ts && tsx tests/sanitizer.test.ts && tsx tests/shifts-be304.test.ts && tsx tests/users-guards.test.ts && tsx tests/e2e-reset-guard.test.ts && tsx tests/scribe-gemini.test.ts && tsx tests/supervision-be702.test.ts && tsx tests/call-request.test.ts && tsx tests/post-session-diagnosis.test.ts && tsx tests/boot-encoding.test.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:db": "tsx tests/db/scribe-concurrency-verification.ts && tsx tests/db/run-verifier-twice.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "tripwires": "bash scripts/tripwires.sh"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@prisma/client": "^5.18.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^1.6.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "prisma": "^5.18.0",
    "tsx": "^4.16.2",
    "typescript": "~5.4.5"
  },
  "allowScripts": {
    "embedded-postgres@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.28.0": true
  }
}
