# RPS-2 Environment Blueprint — fail-fast via src/config/env.ts
# Copy to .env (never commit .env). Rotation impact noted inline.

# Database — Prisma runtime role MUST be clinic_app for REVOKE semantics (Appendix A).
DATABASE_URL="postgresql://clinic_app:CHANGE_ME@localhost:5432/clinic?schema=public"
APP_DB_ROLE="clinic_app"
MIGRATION_DB_ROLE="clinic_owner"

# Auth — both secrets >=32 chars, MUST differ. Rotate => all sessions invalid.
JWT_SECRET="CHANGE_ME_MIN_32_CHARS_JWT_SECRET_000000"
JWT_REFRESH_SECRET="CHANGE_ME_MIN_32_CHARS_REFRESH_SECRET_111111"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Server
PORT="4000"
NODE_ENV="development"
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:3000"
COOKIE_SECURE="false"

# Password hashing (argon2). Higher cost => slower login, stronger hash.
PASSWORD_HASH_COST="3"
REFRESH_REUSE_GRACE_SECONDS="10"

# Clinic defaults (seeded into ClinicSettings singleton)
CLINIC_DEFAULT_FEE_MINOR="50000"
CLINIC_AVG_CONSULT_MIN="20"
CLINIC_CURRENCY="USD"
CLINIC_SECRETARY_MAX_DISCOUNT_MINOR="5000"
CLINIC_SECRETARY_MAX_DISCOUNT_PCT="10"
AUDIO_RETENTION_DAYS="30"
SHIFT_SYSTEM_ENABLED="false"

# Seed owner (rotate password on first login)
SEED_DOCTOR_IDENTIFIER="doctor"
SEED_DOCTOR_PASSWORD="ChangeMe123!"

# Optional
PURGE_JOB_CRON="0 3 * * *"

# BE-503 vault KEK: 32-byte base64 (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Never commit a real KEK; custody per Appendix B (managed secret store, dual-control rotation).
# VAULT_KEK="CHANGE_ME_32B_BASE64_44CHARS_0000000000000000=="
# VAULT_KEK_ID="v1"

# Sprint 6 AI scribe (Google Gemini). Never commit a real key.
# GEMINI_API_KEY is required at RUNTIME for /api/v1/scribe/* (500 GEMINI_KEY_MISSING otherwise).
# GEMINI_MODEL defaults to gemini-3.5-flash-lite when unset.
# GEMINI_API_KEY="CHANGE_ME_GEMINI_KEY"
# GEMINI_MODEL="gemini-3.5-flash-lite"

# Scribe provider switch: 'groq' (Whisper STT + Qwen chat, default) or
# 'gemini' (legacy direct-audio path — kept in code, disabled by default).
# SCRIBE_PROVIDER="groq"
# GROQ_API_KEY is required at RUNTIME when SCRIBE_PROVIDER=groq
# (500 GROQ_KEY_MISSING otherwise). Never commit a real key.
# GROQ_API_KEY="CHANGE_ME_GROQ_KEY"
# GROQ_STT_MODEL="whisper-large-v3"
# GROQ_CHAT_MODEL="qwen/qwen3.8-27b"
# GROQ_MAX_TOKENS="4096"
# GROQ_TIMEOUT_MS="120000"
